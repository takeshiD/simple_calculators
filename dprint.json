{
    "useTabs": false,
    "typescript": {
        "lineWidth": 80,
        "indentWidth": 4,
        "quoteStyle": "preferSingle",
        "semiColons": "always"
    },
    "json": {
        "lineWidth": 80,
        "indentWidth": 4,
        "trailingCommas": "jsonc"
    },
    "excludes": [
        "**/node_modules",
        "**/*-lock.json"
    ],
    "plugins": [
        "https://plugins.dprint.dev/typescript-0.93.3.wasm",
        "https://plugins.dprint.dev/json-0.19.4.wasm"
    ]
}
