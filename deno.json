{
    "tasks": {
        "dev": "deno run --watch main.ts"
    },
    "imports": {
        "@std/assert": "jsr:@std/assert@1"
    },
    "fmt": {
        "useTabs": false,
        "lineWidth": 80,
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": true,
        "proseWrap": "preserve",
        "include": ["src/"],
        "exclude": ["node_modules/"]
    },
    "lint": {
        "include": ["src/"],
        "exclude": ["node_modules/"],
        "rules": {
            "tags": ["recommended"]
        }
    }
}
